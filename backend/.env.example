# ---- PostgreSQL（主数据存储）----
DATABASE_URL=postgresql+asyncpg://linkmind:linkmind@localhost:5432/linkmind

# ---- 鉴权（JWT + 匿名开关；不提供登录接口，匿名放行默认开启）----
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
ALLOW_ANONYMOUS=true

# ---- CORS（逗号分隔前端源；* 表示全部放行）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ---- 知识仓库（真实 Git 目录根，仓库登记/文件扫描均限定在此目录内）----
KNOWLEDGE_ROOT=/app/knowledge
GIT_AUTHOR_NAME=LinkMind
GIT_AUTHOR_EMAIL=linkmind@local
GIT_OPERATION_TIMEOUT=60
GIT_MAX_FILE_BYTES=262144

# ---- Neo4j（仅健康检查连通性使用，业务接口不依赖）----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
