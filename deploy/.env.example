# LinkMind Docker Compose 环境变量模板
# 使用：cp deploy/.env.example deploy/.env，按环境修改后执行
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d --build

# ---- PostgreSQL（主数据）----
POSTGRES_USER=linkmind
POSTGRES_PASSWORD=linkmind
POSTGRES_DB=linkmind
POSTGRES_PORT=5432

# ---- 前端访问端口（宿主机）----
FRONTEND_PORT=8080

# ---- 鉴权（生产必须修改 SECRET_KEY，建议 >=32 字节随机值）----
SECRET_KEY=change-me-to-a-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
# 生产建议 false；关闭匿名前需先具备 Token 签发/注入方案
ALLOW_ANONYMOUS=true

# ---- CORS（逗号分隔；生产填写真实前端域名）----
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# ---- PostgreSQL 连接池 ----
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ---- 知识仓库（宿主机目录 → 容器 /app/knowledge）----
# 必须是可写的真实目录；Git 提交/合并会写回该目录
KNOWLEDGE_HOST_PATH=../docs/示例知识库

# ---- Git 提交身份与限制 ----
GIT_AUTHOR_NAME=LinkMind
GIT_AUTHOR_EMAIL=linkmind@local
GIT_OPERATION_TIMEOUT=60
GIT_MAX_FILE_BYTES=262144
